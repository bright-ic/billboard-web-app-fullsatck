<div class="modal fade request-sent" id="otp_modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
        <div class="modal-content-body">
            <i class="fa-regular fa-circle-check pulse-check fa-bounce"></i>
            <h3>OTP sent successfully</h3>
            <p>We have sent a one-time password to your email. Please check your inbox and enter the code on the next page.</p>
        </div>
       <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal" aria-label="Close">Okay</button>
      </div>
    </div>
  </div>
</div>

