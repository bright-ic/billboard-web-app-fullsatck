<div class="modal fade" id="payment_popup" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="modal-content-body flex-lg-row flex-sm-column-reverse d-flex column-gap-10">
            <div class="payment_method_container">
                <h3>Choose payment method</h3>
                <span>Select the one convenient for you</span>
                <div class="payment-selection-wrapper">
                    <div class="col payment-selection-option active d-flex align-items-center justify-content-between form-control ">
                        <div class="d-flex align-items-center icon-holder">
                            <img src="/images/ussd_icon.png" alt="payment icon">
                            <label for="ussd_transfer" class="custom-radio">USSD Transfer</label>
                        </div>
                        <input type="radio" name="payment_selection" checked id="ussd_transfer" value="ussd">
                    </div>
                     <div class="col payment-selection-option d-flex align-items-center justify-content-between form-control ">
                        <div class="d-flex align-items-center icon-holder">
                            <img src="/images/opay_icon.png" alt="payment icon">
                             <label for="opay_transfer" class="custom-radio">OPay</label>
                        </div>
                        <input type="radio" name="payment_selection" id="opay_transfer" value="opay">
                    </div>
                     <div class="col payment-selection-option d-flex align-items-center justify-content-between form-control ">
                        <div class="d-flex align-items-center icon-holder">
                            <img src="/images/flutterwave_icon.png" alt="payment icon">
                        <label for="flutterwave_transfer" class="custom-radio">Flutterwave</label>
                        </div>
                        <input type="radio" name="payment_selection" id="flutterwave_transfer" value="flutterwave">
                    </div>
                    <button  class="btn btn-primary btn-with-icon w-100 float-inline-end" type="submit" data-bs-toggle="modal" data-bs-target="#transfer_confirmation_modal">Proceed to Payment</button>
                </div>
            </div>
            <div class="order_details_container">
                <h3>Order details</h3>
                <div class="order-wrapper">
                    <div class="order-item d-flex justify-content-between">
                        <span>Biller</span>
                        <p>Ikeja Electric</p>
                    </div>
                    <div class="order-item d-flex justify-content-between">
                        <span>Meter Number</span>
                        <p>0012345678</p>
                    </div>
                    <div class="order-item d-flex justify-content-between">
                        <span>Meter Name</span>
                        <p>JOHN DOE KVAVYDASKMASK</p>
                    </div>
                    <div class="order-item d-flex justify-content-between">
                        <span>Amount</span>
                        <p>₦500</p>
                    </div>
                    <div class="order-item d-flex justify-content-between">
                        <span>Transaction Fee</span>
                        <p>₦50</p>
                    </div>
                    <div class="order-footer text-center">
                            <span>Amount Due</span>
                            <p>₦550</p>
                    </div>
                </div>
            </div>
        </div>
      </div>
    </div>
  </div>
</div>

