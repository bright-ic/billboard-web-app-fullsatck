 <section class="page_container" data-id="transaction_section">
   <div class="section_wrapper transaction_section" id="transaction_section">
        <div class="container">
            <div class="content-container">
                <div class="container my-10">
                     <div class="breadcum-wrapper d-block d-md-flex align-items-center justify-content-between">
                           <div class="left-container">
                              <h3>All your payments here</h3>
                              <div class="span">Find details of your previous transaction by clicking on the one you would like to view </div>
                           </div>
                           <div class="right-container d-none d-md-flex">
                             <img src="/images/electric_calculator.png" alt="background icon" class="w-100">
                             <!-- <img src="/images/frame-blue.png" alt="background icon" class="w-185">
                              <img src="/images/frame-white.png" alt="background icon" class="w-185"> -->
                           </div>
                     </div>
                </div>
                <div class="container">
                    <div class="card shadow-sm mt-5 border-0">
                        <div class="card-body p-4">


                        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                            <h5 class="fw-bold mb-0">Recent transactions</h5>
                            <div class="d-flex gap-2 align-items-center jusstify-content-center">
                            <input type="text" class="form-control" value="12-01-2023  -  12-01-2023" style="max-width: 230px;" />
                            <select class="form-select" style="max-width: 150px;">
                                <option selected>Categories</option>
                                <option value="1">Electricity</option>
                                <option value="2">Internet</option>
                            </select>
                            </div>
                        </div>

                        <!-- NOVEMBER SECTION -->
                        <h6 class="text-muted fw-semibold text-uppercase mb-3">November</h6>
                               <% const transactions = [
  { transaction_type: 'electricity' },
  { transaction_type: 'recharge' },
  { transaction_type: 'subscription' }
]; %>
  <% transactions.forEach(tx => { %>
                            <div class="list-group border-0">
                                <div class="list-group-item d-flex justify-content-between align-items-center border-0 p-2 rounded mb-2">
                                    <div class="d-flex align-items-center gap-3">
                                        <% if (tx.transaction_type === 'electricity') { %>
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="background: #F2F8FF; width: 50px; height: auto;">
                                           <img src="/images/icons/electric-icon.png" alt="icon" class="w-100">
                                        </div>
                                       <% } else if (tx.transaction_type === 'recharge') { %>
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="background: #E9F9EF; width: 50px; height: auto;">
                                            <img src="/images/icons/recharge-icon.png" alt="icon" class="w-100">
                                        </div>
                                       <% } else if (tx.transaction_type === 'subscription') { %>
                                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="background: #EEF2FF; width: 50px; height: auto;">
                                            <img src="/images/icons/subscription-icon.png" alt="icon" class="w-100">
                                        </div>
                                        <% } %>
                                       

                                        <div>
                                            <div><%= tx.transaction_type %></div>
                                        <div class="fw-semibold trans-info"><%= tx.name %></div>
                                        <small class="text-muted trans-date"><%= tx.date || 'Jul 02, 2025' %> • <%= tx.time || '6:40 PM' %></small>
                                        </div>
                                    </div>
                                     <div class="text-end d-none d-md-block">
                                        <div class="fw-bold trans-amount">₦<%= tx.amount || '0.00' %></div>
                                    </div>
                                    <div class="text-end d-none d-md-block">
                                        <div class="text-muted small trans-id"><%= tx.txn_id || 'BB1234ABtfw24' %></div>
                                    </div>
                                    <div class="trans-status d-none d-md-block">
                                        <% if (tx.status === 'success') { %>
                                            <span class="badge rounded-pill bg-success-subtle text-success d-flex align-items-center gap-1 px-3 py-2"><i class="fa-solid fa-circle-check"></i> Successful</span>
                                        <% } else if (tx.status === 'pending') { %>
                                            <span class="badge rounded-pill d-flex align-items-center gap-1 px-3 py-2 bg-warning-subtle text-warning"><i class="fa-regular fa-clock-rotate-left"></i> Pending</span>
                                        <% } else { %>
                                            <span class="badge rounded-pill d-flex align-items-center gap-1 px-3 py-2 bg-danger-subtle text-danger"><i class="fa-regular fa-circle-xmark"></i> Failed</span>
                                        <% } %>
                                    </div>
                                    <div>
                                         <div class="fw-bold d-block d-md-none trans-amount">₦<%= tx.amount || '0.00' %></div>
                                        <div class="chevron-holder d-none d-md-flex"> <i class="fa-solid fa-chevron-right text-muted "></i></div>
                                    </div>
                                </div>
                            </div>
                             <% }); %>

                             <div class="pagination-footer pagina d-flex align-items-center justify-content-center gap-3 mt-4">
                                <button type="button" class="btn btn-inactive">Previous</button>
                                 <div style="display: flex;align-items: center;justify-content: space-between;column-gap: 10px;">
                                     <span class="text-muted">Page</span><input type="number" min="1" max="24" value="1" class="form-control text-center"style="width: 42px; height:auto " /> <span class="text-muted">of 24</span>
                                 </div>
                                <button type="button" class="btn btn-primary btn-active">Next</button>
                            </div>
                        </div>
                        </div>
                </div>
            </div>
        </div>
    </div>
</section>