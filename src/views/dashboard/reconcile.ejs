 <section class="page_container" >
   <div class="section_wrapper transaction_section electricity-caculator-section" id="electricity-caculator_section">
        <div class="container">
            <div class="content-container">
                <div class="container my-10">
                     <div class="breadcum-wrapper d-block d-md-flex align-items-center justify-content-between">
                           <div class="left-container">
                              <h3>Reconcile your electricity bill</h3>
                              <div class="span">Ensure you are receiving the accurate bill for your meter from power holding companies, and pay only for the electricity you use.</div>

                            </div>
                           <div class="right-container d-none d-md-flex">
                             <img src="/images/reconcile_calculator.png" alt="background icon" class="w-100">
                           </div>
                     </div>
                </div>
                <div class="container">
                    <div class="row gx-5">
                        <div class="col-lg-6 col-md-12">
