                                            <div class="row">
                                                <h4>Monthly Bill Regularization content goes here</h4>
                                            </div>
                                          </div>
                                        </div>
                              </div>
                               <div class="tab-pane-content " id="tab3">
                                     <div class="card shadow-sm mt-3 border-0">
                                          <div class="card-body p-4">
                                            <div class="row">
                                                <h4>Bulk Bill Management content goes here</h4>
                                            </div>
                                          </div>
                                        </div>
                               </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

