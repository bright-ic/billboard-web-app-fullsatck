        <button class="badge badge-light badge-sm mx-1 delete-row"><i class="fa-solid fa-trash-can"></i></button>
        </div>
    </div>
      `;

    
      const rowCard = $('<div class="responsive-row-wrapper mb-2"></div>').html(rowContent);
      $('#appliance-rows').append(rowCard);
    });

    // Handle delete
    $('#appliance-rows').on('click', '.delete-row', function () {
      $(this).closest('.responsive-row-wrapper').remove();
    });
  });

//  on mobile the items are display in a card not using the table structure on desktop, so i tried working around that, we can make neccessary adjustments in design or code
function wrapRowsForSmallScreens() {
  const container = document.getElementById('appliance-rows');
  const isSmallScreen = window.innerWidth < 768;

  
  Array.from(container.children).forEach(child => {
    if (isSmallScreen) {
      if (child.classList.contains('row')) {
        
        const wrapper = document.createElement('div');
        wrapper.className = 'card responsive-row-wrapper';
        wrapper.appendChild(child.cloneNode(true));
        container.replaceChild(wrapper, child);
      }
    } else {
      if (child.classList.contains('card') && child.classList.contains('responsive-row-wrapper')) {
        const row = child.querySelector('.row');
        container.replaceChild(row, child);
      }
    }
  });
}


window.addEventListener('resize', wrapRowsForSmallScreens);


window.addEventListener('DOMContentLoaded', () => {
  wrapRowsForSmallScreens();

 
  document.getElementById('add-row').addEventListener('click', () => {
    if (window.innerWidth < 768) {
